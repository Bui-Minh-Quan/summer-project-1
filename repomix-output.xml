<file path="app/web/nginx.conf">
server {
    listen 80;

    # Serve compiled React static files
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Proxy REST API requests directly to gateway-api container
    location /api/ {
        proxy_pass http://gateway-api:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Proxy WebSocket live ticker connections
    location /api/v1/stream/ {
        proxy_pass http://gateway-api:8000/api/v1/stream/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }
}
</file>

