name: API Gateway CI Pipeline

on:
  workflow_dispatch:
  push:
    branches: [ main, develop, 'feature/*', 'api/*' ]
    paths:
      - 'app/api/**'
      - '.github/workflows/api_ci.yml'
      - 'requirements.txt'

  pull_request:
    branches: [ main, develop ]
    paths:
      - 'app/api/**'
      - '.github/workflows/api_ci.yml'
      - 'requirements.txt'

jobs:
  validate-and-test:
    name: Lint, Type Check & Test (API Gateway)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository Code
        uses: actions/checkout@v4

      - name: Set up Python 3.12
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'

      - name: Install Platform & API Dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then
            pip install -r requirements.txt
          fi
          if [ -f app/api/requirements.txt ]; then
            pip install -r app/api/requirements.txt
          fi

      - name: Run Ruff Code Linter
        run: |
          ruff check app/api/

      - name: Run Mypy Static Type Checking
        run: |
          mypy app/api/ --ignore-missing-imports --explicit-package-bases

      - name: Run Pytest Test Suite
        run: |
          cd app/api
          pytest tests/ -v
</file>

